# Required: single shared password for dashboard access
APP_PASSWORD=change-me-to-a-strong-secret

# Optional: secret used to sign the auth cookie (defaults to APP_PASSWORD)
AUTH_SECRET=

# Optional: RapidAPI key for live LinkedIn job listings via JSearch
# Subscribe: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Optional: SerpAPI key for live LinkedIn feed posts (Google site: search)
# https://serpapi.com/
SERPAPI_KEY=

# Logged-in browser mode (Playwright): copy li_at after signing in at linkedin.com
LINKEDIN_LI_AT=
# Optional:
# LINKEDIN_JSESSIONID=
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Run once locally: npx playwright install chromium
# Optional: RapidAPI key for live LinkedIn job listings via JSearch
# Subscribe: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Optional: SerpAPI key for live LinkedIn feed posts (Google site: search)
# https://serpapi.com/
SERPAPI_KEY=